# Used by e2e tests (test/setup-env.ts). Copy to .env.test to override.
# Points at the flowboard_test database created by docker/postgres/init.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://flowboard:flowboard@localhost:5432/flowboard_test?schema=public
REDIS_URL=redis://localhost:6379/1
JWT_ACCESS_SECRET=test-only-secret-not-used-anywhere-else-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_HOURS=168
THROTTLE_LIMIT=10000
THROTTLE_AUTH_LIMIT=10000

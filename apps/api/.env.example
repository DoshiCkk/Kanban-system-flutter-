# Copy to .env:  Copy-Item .env.example .env
NODE_ENV=development
PORT=3000
# Single allowed origin; leave empty to allow all in development.
CORS_ORIGIN=

DATABASE_URL=postgresql://flowboard:flowboard@localhost:5432/flowboard?schema=public
REDIS_URL=redis://localhost:6379/0

# Generate a real secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_HOURS=168

# Requests per minute per IP: global and for /auth endpoints.
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10
